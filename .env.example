APP_ENV=development
LOG_LEVEL=INFO

# Default production/free path: Neon Postgres + Groq gpt-oss-120b.
# For local Docker Compose use:
# DATABASE_URL=postgresql+asyncpg://pvz_ai:pvz_ai@localhost:5432/pvz_ai
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/DBNAME?ssl=require
AUTO_CREATE_TABLES=false

LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
HF_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3
LLM_TOP_P=1.0
LLM_MAX_TOKENS=1024
GROQ_API_KEY=

# Optional Hugging Face router fallback. If HF_TOKEN is set, "auto" mode tries
# Hugging Face when the primary Groq request fails.
# LLM_PROVIDER=huggingface
# LLM_BASE_URL=https://router.huggingface.co/v1
HF_TOKEN=

# Local/test-only provider. Do not use for production:
# LLM_PROVIDER=echo
